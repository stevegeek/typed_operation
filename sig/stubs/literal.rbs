module Literal
  class Struct
  end

  class Data
  end

  module Types
    class NilableType
      def initialize: (untyped) -> void
    end

    interface _Matchable
      def ===: (untyped) -> boolish
    end

    def _Union: (*untyped) -> untyped
    def self._Any?: () -> untyped
  end

  class Result
    def success?: () -> bool
    def failure?: () -> bool
    def value!: () -> untyped
    def error!: () -> untyped
  end

  class Success < Result
    def initialize: (untyped, success_type: untyped, failure_type: untyped) -> void
  end

  class Failure < Result
    def initialize: (untyped, success_type: untyped, failure_type: untyped) -> void
  end

  module Undefined
  end

  interface _Property
    def name: () -> Symbol
    def positional?: () -> bool
    def keyword?: () -> bool
    def required?: () -> bool
  end
end
